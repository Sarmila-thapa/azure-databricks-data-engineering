{
  "datasets": [
    {
      "name": "63249df9",
      "displayName": "orders",
      "config": {
        "version": "1.1",
        "source": "sales_catalog.sales.orders",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "607684bd",
      "displayName": "City Sales Summary by Total Amount",
      "queryLines": [
        "SELECT\r\n",
        "    city,\r\n",
        "    SUM(amount) AS total_sales\r\n",
        "FROM sales_catalog.sales.orders\r\n",
        "GROUP BY city\r\n",
        "ORDER BY total_sales DESC;\r\n"
      ],
      "catalog": "sales_catalog",
      "schema": "default"
    },
    {
      "name": "d539a7b6",
      "displayName": "Top Product Sales Summary by Amount",
      "queryLines": [
        "SELECT\r\n",
        "    product,\r\n",
        "    SUM(amount) AS total_sales\r\n",
        "FROM sales_catalog.sales.orders\r\n",
        "GROUP BY product\r\n",
        "ORDER BY total_sales DESC;\r\n"
      ],
      "catalog": "sales_catalog",
      "schema": "sales"
    }
  ],
